{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window may do: only BlackBoxus's own commands, and listening for the app's own events, nothing else from Tauri's built-in plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-status",
    "allow-rate-password",
    "allow-create-account",
    "allow-sign-in",
    "allow-unlock",
    "allow-lock",
    "allow-sync-vaults",
    "allow-list-items",
    "allow-get-item",
    "allow-reveal-field",
    "allow-copy-field",
    "allow-save-item",
    "allow-scan-code",
    "allow-cancel-scan",
    "allow-autofill-status",
    "allow-autofill-settings",
    "allow-pending-changes",
    "allow-conflict-field",
    "allow-resolve-conflict",
    "allow-delete-item",
    "allow-generate-password",
    "allow-my-sharing-id",
    "allow-vault-members",
    "allow-look-up-member",
    "allow-share-vault",
    "allow-compare-safety-number",
    "allow-copy-text",
    "allow-import-choose-file",
    "allow-import-start",
    "allow-import-duplicates",
    "allow-import-progress",
    "allow-import-finish",
    "allow-hello-enable",
    "allow-hello-disable",
    "allow-unlock-with-hello",
    "allow-totp-code",
    "allow-get-settings",
    "allow-set-settings",
    "allow-show-emergency-kit",
    "allow-sign-out",
    "allow-change-member-role",
    "allow-remove-member",
    "allow-leave-vault",
    "allow-recovery-key-status",
    "allow-create-recovery-key",
    "allow-remove-recovery-key",
    "allow-recover-account",
    "allow-change-password",
    "allow-emergency-status",
    "allow-look-up-contact",
    "allow-set-trusted-contact",
    "allow-remove-trusted-contact",
    "allow-deny-emergency",
    "allow-request-emergency",
    "allow-open-emergency",
    "allow-close-emergency",
    "allow-password-health",
    "allow-open-website",
    "allow-create-vault",
    "allow-rename-vault",
    "allow-browser-status",
    "allow-set-browser-integration",
    "allow-answer-browser-pairing",
    "allow-forget-browser",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
